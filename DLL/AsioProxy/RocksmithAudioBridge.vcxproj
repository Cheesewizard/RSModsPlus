<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32"><Configuration>Debug</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug with Wwise Logging|Win32"><Configuration>Debug with Wwise Logging</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32"><Configuration>Release</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release with Wwise Logging|Win32"><Configuration>Release with Wwise Logging</Configuration><Platform>Win32</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals"><ProjectGuid>{C7A9E1F2-3B4D-4E5A-9C6B-1D2E3F4A5B6C}</ProjectGuid><WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration"><ConfigurationType>DynamicLibrary</ConfigurationType><PlatformToolset>v143</PlatformToolset><UseDebugLibraries>false</UseDebugLibraries></PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup><TargetName>RocksmithAudioBridgeAsio</TargetName><OutDir>$(ProjectDir)..\..\Installer\Resources\$(Configuration)\</OutDir><IntDir>$(ProjectDir)..\..\build\AsioProxy\$(Configuration)\</IntDir></PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile><LanguageStandard>stdcpp17</LanguageStandard><RuntimeLibrary>MultiThreaded</RuntimeLibrary><Optimization>MaxSpeed</Optimization><PrecompiledHeader>NotUsing</PrecompiledHeader><PreprocessorDefinitions>WIN32;_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions></ClCompile>
    <Link><ModuleDefinitionFile>RocksmithAudioBridge.def</ModuleDefinitionFile><AdditionalDependencies>ole32.lib;advapi32.lib;propsys.lib;%(AdditionalDependencies)</AdditionalDependencies><GenerateDebugInformation>true</GenerateDebugInformation></Link>
  </ItemDefinitionGroup>
  <ItemGroup><ClCompile Include="AsioProxyDriver.cpp" /><ClCompile Include="VirtualCableCapture.cpp" /></ItemGroup>
  <ItemGroup><None Include="RocksmithAudioBridge.def" /></ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Ships the proxy driver into the game root after every build (shared DeployToGame.targets). The
       driver is registered by path, so replacing the file in place keeps the registration. -->
  <Target Name="CollectGameDeployFiles" BeforeTargets="DeployToGame">
    <ItemGroup>
      <GameDeployFile Include="$(TargetPath)" Destination="$(RocksmithInstallDir)\RocksmithAudioBridgeAsio.dll" />
    </ItemGroup>
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)..\..\DeployToGame.targets" />
</Project>
