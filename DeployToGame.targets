<?xml version="1.0" encoding="utf-8"?>
<!--
  Deploys a project's outputs into the Rocksmith folder after EVERY build, so the game DLL, the proxy
  driver and the GUI can never drift out of sync with each other (the 2026-09-15 rule: what is built is
  what runs). Each project lists what it ships as @(GameDeployFile) items with a Destination.

  A running game or bridge keeps its files locked, but Windows allows a mapped executable to be renamed,
  so the live copy is parked as "<file>.previous" and the fresh build lands in its place. The running
  process keeps using the parked copy until it restarts; nothing is killed here.

  Skip with -p:DeployToGame=false. Point elsewhere with -p:RocksmithInstallDir=... . Never runs for the
  "Release Public" configuration (that is the installer payload, not a dev deploy).
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RocksmithInstallDir Condition="'$(RocksmithInstallDir)'==''">C:\Program Files (x86)\Steam\steamapps\common\Rocksmith2014</RocksmithInstallDir>
    <DeployToGame Condition="'$(DeployToGame)'==''">true</DeployToGame>
  </PropertyGroup>

  <Target Name="DeployToGame" AfterTargets="Build"
          Condition="'$(DeployToGame)'=='true' And Exists('$(RocksmithInstallDir)') And '$(Configuration)'!='Release Public'">
    <Error Condition="'@(GameDeployFile)'==''" Text="DeployToGame: this project declares no GameDeployFile items." />
    <Error Condition="!Exists('%(GameDeployFile.Identity)')" Text="DeployToGame: build output is missing: %(GameDeployFile.Identity)" />
    <!-- Park whatever is live. Failures here only mean nothing was there or a stale .previous is itself
         still in use; the Copy below is the step that must succeed. -->
    <Delete Files="%(GameDeployFile.Destination).previous" ContinueOnError="true" />
    <Move SourceFiles="%(GameDeployFile.Destination)" DestinationFiles="%(GameDeployFile.Destination).previous"
          Condition="Exists('%(GameDeployFile.Destination)')" ContinueOnError="true" />
    <Copy SourceFiles="@(GameDeployFile)" DestinationFiles="%(GameDeployFile.Destination)" />
    <Message Importance="high" Text="DeployToGame: %(GameDeployFile.Filename)%(GameDeployFile.Extension) -> %(GameDeployFile.Destination)" />
  </Target>
</Project>
